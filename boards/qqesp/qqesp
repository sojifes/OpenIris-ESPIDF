CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_BLINK_GPIO=38
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
# CONFIG_ESPTOOLPY_FLASHSIZE_1MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_32MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_64MB is not set
# CONFIG_ESPTOOLPY_FLASHSIZE_128MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_QOUT is not set
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set
# CONFIG_ESPTOOLPY_FLASHMODE_DOUT is not set
# Note: ESPTOOLPY_FLASHMODE string is derived by Kconfig and writes "dio" to
# the .bin header for any quad mode. Second-stage bootloader switches to QIO
# at runtime based on the boolean above. See esptool_py/Kconfig.projbuild.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
# Camera sensor pinout configuration (XIAOMO_VR_DEVICE_V1 / wrooms3 base)
CONFIG_CAMERA_MODULE_NAME="QQESP"
CONFIG_PWDN_GPIO_NUM=40
CONFIG_RESET_GPIO_NUM=-1
CONFIG_XCLK_GPIO_NUM=15
CONFIG_SIOD_GPIO_NUM=4
CONFIG_SIOC_GPIO_NUM=5
CONFIG_Y9_GPIO_NUM=16
CONFIG_Y8_GPIO_NUM=17
CONFIG_Y7_GPIO_NUM=18
CONFIG_Y6_GPIO_NUM=12
CONFIG_Y5_GPIO_NUM=10
CONFIG_Y4_GPIO_NUM=8
CONFIG_Y3_GPIO_NUM=9
CONFIG_Y2_GPIO_NUM=11
CONFIG_VSYNC_GPIO_NUM=6
CONFIG_HREF_GPIO_NUM=7
CONFIG_PCLK_GPIO_NUM=13
# end of Camera sensor pinout configuration
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
# Camera xclk pinned to the QQESP firmware default (was hardcoded 20MHz)
CONFIG_CAMERA_USB_XCLK_FREQ=20000000
CONFIG_CAMERA_WIFI_XCLK_FREQ=20000000
# IR LED on GPIO41, P-MOSFET driven (active-low), 5kHz / 8-bit / ~82% default
# (matches the QQESP firmware default of ir_brightness=210)
CONFIG_LED_EXTERNAL_CONTROL=y
CONFIG_LED_EXTERNAL_GPIO=41
CONFIG_LED_EXTERNAL_PWM_FREQ=5000
CONFIG_LED_EXTERNAL_PWM_DUTY_CYCLE=82
CONFIG_LED_EXTERNAL_ACTIVE_LOW=y
# QQESP has no LED current sense circuit — disable to avoid reading noise
# from an unrelated/floating ADC pin (the default GPIO3 is facefocusvr-specific).
# CONFIG_MONITORING_LED_CURRENT is not set
# Battery monitor on GPIO1 (ADC1_CH0), 2:1 divider (10k/10k)
CONFIG_MONITORING_BATTERY_ENABLE=y
CONFIG_MONITORING_BATTERY_ADC_GPIO=1
CONFIG_MONITORING_BATTERY_DIVIDER_R_TOP_OHM=10000
CONFIG_MONITORING_BATTERY_DIVIDER_R_BOTTOM_OHM=10000
CONFIG_MONITORING_BATTERY_SAMPLES=10
CONFIG_MONITORING_BATTERY_INTERVAL_MS=1000
# UVC support is compiled in but the device boots into SETUP/WiFi by default
CONFIG_GENERAL_INCLUDE_UVC_MODE=y
CONFIG_GENERAL_BOARD="babble"
CONFIG_GENERAL_VERSION="0.2.0"
CONFIG_GENERAL_ADVERTISED_NAME="qqesp"
CONFIG_GENERAL_ENABLE_WIRELESS=y
